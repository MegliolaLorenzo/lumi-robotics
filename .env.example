# === REQUIRED ===
# OpenAI API key — needed for GPT-4o Vision detection
OPENAI_API_KEY=sk-...

# === OPTIONAL ===

# Video source: webcam | robot | video (default: webcam)
VIDEO_SOURCE=webcam

# Robot mode only: IP of the Unitree Go2 on the WiFi network
# Leave empty — start.py auto-discovers and fills this in
ROBOT_IP=
ROBOT_STREAM_URL=http://localhost:8080/api/video/stream

# Alert output mode: print | file | webhook (default: print)
ALERT_MODE=print

# Only used when ALERT_MODE=webhook
ALERT_WEBHOOK_URL=

# Detection tuning
CONFIDENCE_THRESHOLD=0.65
COOLDOWN_SECONDS=15
